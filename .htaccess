# Matikan daftar folder (directory listing)
Options -Indexes

# 1. ENFORCE HTTPS (Finding #6: Plain HTTP to HTTPS redirect)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Sembunyikan signature server di halaman error (Finding #14)
ServerSignature Off

# 2. SECURITY HEADERS STANDAR OWASP (Findings #3, #4, #5, #9, #10, #14, #15, #16)
<IfModule mod_headers.c>
    # Sembunyikan banner teknologi dan versi (Information Disclosure)
    Header always unset Server
    Header unset Server
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Finding #9: X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"

    # Finding #5: X-Frame-Options (Clickjacking defense)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Finding #10: Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Finding #4: Strict-Transport-Security (HSTS 1 tahun + includeSubDomains + preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Finding #15: Cross-Origin-Opener-Policy
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Finding #16: Permissions-Policy (Tutup akses fitur/sensor yang tidak terpakai)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Proteksi XSS Legacy
    Header always set X-XSS-Protection "1; mode=block"

    # Finding #3: Content-Security-Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src 'self' data: blob: https://drive.google.com; object-src 'self' data: blob:; connect-src 'self' https://plausible.io https://*.googleapis.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com"
</IfModule>

# 3. SESSION COOKIE HARDENING via PHP Module (Finding #2)
<IfModule mod_php7.c>
    php_flag expose_php off
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_value session.cookie_samesite Lax
    php_flag session.use_only_cookies on
    php_flag session.use_strict_mode on
</IfModule>
<IfModule mod_php.c>
    php_flag expose_php off
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_value session.cookie_samesite Lax
    php_flag session.use_only_cookies on
    php_flag session.use_strict_mode on
</IfModule>

# 4. BLOKIR AKSES FILE SENSITIF & DORKING (Finding #13)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(README\.md|composer\.json|composer\.lock|\.env|\.env\.example|\.user\.ini|error_log|indes\.log|openapi\.yaml|Dockerfile|docker-compose\.yml|package\.json|package-lock\.json|phpunit\.xml)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|bak|sql|env|ini|yml|yaml|sh|dist)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(test_|debug_|diag_|cek_|cleanup_final\.php)">
    Require all denied
</FilesMatch>

# Blokir direktori non-aplikasi (tools OCR, tests, docs, database, scripts, .kiro, .github)
RedirectMatch 404 (^|/)(tools|tests|docs|database|scripts|\.kiro|\.github|node_modules)(/|$)

# Kompresi gzip untuk teks/aset
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Cache aset statis lama
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresDefault "access plus 1 hour"
</IfModule>