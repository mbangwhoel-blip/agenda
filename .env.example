# ===========================================
# .env.example — copy ke .env dan isi nilai produksi
# ===========================================
# JANGAN commit .env ke git! Tambahkan ke .gitignore.

# Environment: development | production
APP_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agenda_pimpinan
DB_USER=agenda_app
DB_PASS=GANTI_PASSWORD_KUAT

# Session security
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# HaveIBeenPwned password check (aktifkan di production: false)
PWNED_CHECK_DISABLE=true

# Cron webhook secret (untuk reminder_cron.php via Authorization: Bearer)
CRON_SECRET_KEY=generate-64-hex-random-disini

# SMTP (override secrets.php)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=bblkl.salatiga@gmail.com
SMTP_PASS=GANTI_APP_PASSWORD
SMTP_FROM_EMAIL=no-reply@bblabkesling.go.id
SMTP_FROM_NAME=Agenda Pimpinan BBLKL

# Resend API
RESEND_API_KEY=re_GANTI_KEY_BARU

# Analytics (Plausible self-hosted, kosongkan jika tidak pakai)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=

# Google Drive untuk arsip lampiran surat. Folder harus dibagikan ke email service account sebagai Editor.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=
