{
    "name": "bblkl/agenda-pimpinan",
    "description": "Sistem arsip digital agenda surat dan kegiatan pimpinan BBLKL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php",
            "app/i18n.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "security:check": "composer audit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
